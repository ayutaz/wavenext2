# .env のテンプレート。実際の値を入れた .env は .gitignore で除外される。
# 値はここに書かない (placeholder のみ)。`cp .env.example .env` してローカルで編集する。

# --- secrets (任意、使う場合のみ) ---
WANDB_API_KEY=
HF_TOKEN=

# --- スレッド数 (DataLoader worker x BLAS のオーバーサブスクリプション対策) ---
# 1 を推奨。多 worker 環境で BLAS が全コアを奪い I/O が詰まるのを防ぐ。
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# --- GPU 選択 ---
CUDA_VISIBLE_DEVICES=0

# --- データセット root (configs/*.yaml の data.root を上書きする場合) ---
WAVENEXT2_DATA_ROOT=
