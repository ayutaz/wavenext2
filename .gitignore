# =========================================================================
# 著作物 (リポジトリ公開時に同梱しない)
# =========================================================================
# 論文 PDF / 抽出テキスト / 画像化したページ
*.pdf
paper.txt
paper.pdf
pdf_pages/
page_*.png

# 参考実装からダウンロードしたソース (CLAUDE.md で「コピー流用しない」と明記)
wavenext_orig*
wavenext_raw*
wavenext.yaml
# 上記は本来 configs/wavenext2_*.yaml のみ commit する。誤って外部ファイル名で commit しない

# =========================================================================
# データセット
# =========================================================================
# LibriTTS-R は別途ダウンロード、リポジトリには含めない
data/LibriTTS_R/
data/libritts_r/
*.wav
*.flac
*.mp3
# filelist / 統計は commit する (パスと統計のみ、wav 本体は上の *.wav で除外)
# data/filelists/*.tsv, stats.json, audio_info.tsv は data/ が一括除外でないため既定で追跡される

# =========================================================================
# 学習成果物
# =========================================================================
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
runs/
wandb/
tensorboard/
*.pt
*.pth
*.ckpt
*.safetensors

# 後処理 (post-filter FIR)
*.npy
# fir.npy は M6.2 後に commit (2 KB、reproducibility は fit_stats.json で担保、T-M3.4)。
!post_filter/fir.npy

